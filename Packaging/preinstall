#!/bin/sh
set -eu
if [ "${3:-/}" != / ]; then
    echo 'Install on the running macOS startup disk only.' >&2
    exit 1
fi
rollo_scripts_dir=$(/usr/bin/dirname "$0")
# Embedded native tool; no Python, Xcode, network access, or third-party runtime.
exec "$rollo_scripts_dir/rollo-pacing" prepare-install
